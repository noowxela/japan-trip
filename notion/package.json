{
  "name": "notion-as-code-project",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/lib/entry.ts --bundle --platform=node --format=esm --outfile=dist/build.mjs && node dist/build.mjs",
    "setup:api": "node scripts/setup-via-api.mjs",
    "migrate:v2": "node scripts/migrate-v2.mjs",
    "sync:place-maps": "node scripts/sync-place-maps.mjs",
    "add:transit-visited": "node scripts/add-transit-visited.mjs",
    "add:skipped": "node scripts/add-skipped.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
